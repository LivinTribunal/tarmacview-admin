# Reverse-engineering scratch — raw captures from the predecessor system contain
# personal data of real pilots across several operator organisations. Never commit.
.raw/
captures/
*.har

# Working memory for the /rebuild loop. A cache, not the ledger — issues and git
# history are authoritative, and losing this directory loses nothing.
.rebuild/

# PHP / Composer
/vendor/
composer.phar

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Next.js build output
.next/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.phpunit.result.cache

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
*.env
!.env.example

# Logs
*.log

# Build artifacts
.harness/
out/

# harnext keeps the risk contract and the check scripts under .harnext/ and they are
# invoked by the workflows, so the directory is tracked. Its own .harnext/.gitignore
# excludes the throwaway parts (analysis-runs/, tech-stack.json).
.harnext/logs/
public/build/
public/hot

# Storage / uploads
storage/*.key
storage/app/public/
storage/framework/
storage/logs/

# the local FILE_STORAGE_ROOT from .env.example. what lands there is operator data -
# logos, permits, incident files - and none of it belongs in the repo.
/var/

# Backups & dumps
backups/
*.dump
*.sql.gz

# Flight-log fixtures — scrub before committing any sample, then whitelist it
fixtures/raw/
