{
  "version": "1",
  "riskTierRules": {
    "high": [
      ".github/workflows/**",
      ".harnext/**",
      "CLAUDE.md",
      "CONTEXT.md",
      "README.md",
      "docs/specs/**",
      "harness.config.json",
      "scripts/**"
    ],
    "low": [
      "**"
    ]
  },
  "mergePolicy": {
    "high": {
      "requiredChecks": [
        "risk-policy-gate",
        "conventions-check",
        "structural-tests",
        "CI Pipeline"
      ]
    },
    "low": {
      "requiredChecks": [
        "risk-policy-gate",
        "conventions-check",
        "CI Pipeline"
      ]
    }
  }
}
