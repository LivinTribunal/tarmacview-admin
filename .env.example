# the application's own database role. it must be neither SUPERUSER nor BYPASSRLS:
# either one skips every row-level security policy without changing anything a schema
# dump would show. drizzle/0001_force_rls_and_app_role.sql creates the group role it
# should belong to.
DATABASE_URL=postgres://tarmacview_app@localhost:5432/tarmacview

# better auth's signing secret and public origin. generate the secret per deployment and
# never commit a real one.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# where uploaded files live on disk. it must sit outside anything the web server publishes:
# a file leaves this directory only through a route that has already read the row owning it,
# never as a static path. there is no default - an unset value fails the first file request.
FILE_STORAGE_ROOT=./var/storage
