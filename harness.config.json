{
  "version": "1.0.0",
  "repoRoot": ".",
  "detection": {
    "primaryLanguage": "TypeScript",
    "framework": null,
    "packageManager": null,
    "ciProvider": "GitHub Actions",
    "monorepo": false,
    "note": "TypeScript rebuild, decided against the Laravel-and-Filament recommendation still standing in docs/specs/01-tech-stack.md; that document records the predecessor's fingerprint, not this decision. Framework and package manager are settled by the walking skeleton. Risk-tier patterns are already TypeScript-shaped so that authorisation and tenant-scoping code cannot land as tier 1. The lint and test commands still point at the shell gates only: pointing them at npm scripts before a package.json exists would break the pipeline, so they flip when the skeleton lands."
  },
  "riskTiers": {
    "tier1": {
      "name": "low",
      "description": "Documentation, markdown, changelogs, and non-code config changes",
      "patterns": [
        "docs/**",
        "*.md",
        "**/*.md",
        "**/*.txt",
        "CHANGELOG*",
        ".editorconfig",
        ".gitignore"
      ],
      "requiredChecks": [
        "lint",
        "structural-tests"
      ],
      "mergePolicy": {
        "minApprovals": 0,
        "requireReviewAgent": false,
        "allowSelfMerge": true
      },
      "evidenceRequirements": [
        "lint-clean",
        "structural-clean"
      ]
    },
    "tier2": {
      "name": "medium",
      "description": "Application source, tests, and build configuration",
      "patterns": [
        "src/**",
        "app/**",
        "lib/**",
        "components/**",
        "server/**",
        "tests/**",
        "e2e/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "next.config.*",
        "vite.config.*",
        "vitest.config.*",
        "playwright.config.*",
        "tailwind.config.*"
      ],
      "requiredChecks": [
        "lint",
        "type-check",
        "test",
        "build"
      ],
      "mergePolicy": {
        "minApprovals": 1,
        "requireReviewAgent": true,
        "allowSelfMerge": false
      },
      "evidenceRequirements": [
        "tests-pass",
        "lint-clean",
        "type-check-clean"
      ]
    },
    "tier3": {
      "name": "high",
      "description": "Tenant isolation, authorisation, flight-log parsing, schema migrations, and the extracted contracts. Getting the first four wrong is either a cross-tenant data breach or a corruption of the airworthiness record. The contracts are the test oracle: anything that can weaken an assertion can make every gate report green while the behaviour is wrong.",
      "patterns": [
        "**/*polic*",
        "**/*permission*",
        "**/*authoriz*",
        "**/*authoris*",
        "**/auth/**",
        "**/*tenant*",
        "**/*scope*",
        "**/*parser*",
        "**/*import*",
        "**/middleware.ts",
        "**/migrations/**",
        "drizzle/**",
        "prisma/migrations/**",
        "prisma/schema.prisma",
        "contracts/**"
      ],
      "requiredChecks": [
        "lint",
        "type-check",
        "test",
        "build",
        "manual-approval"
      ],
      "mergePolicy": {
        "minApprovals": 2,
        "requireReviewAgent": true,
        "allowSelfMerge": false
      },
      "evidenceRequirements": [
        "tests-pass",
        "lint-clean",
        "type-check-clean",
        "manual-review"
      ]
    }
  },
  "commands": {
    "lint": "bash scripts/check-conventions.sh",
    "test": "bash scripts/structural-tests.sh",
    "build": null,
    "typeCheck": null
  },
  "shaDiscipline": {
    "enabled": true,
    "enforceExactSha": true,
    "rejectStaleReviews": true,
    "description": "All CI gates pin to exact commit SHA from the risk policy gate"
  },
  "architecturalBoundaries": {},
  "docsDrift": {
    "trackedDocs": [
      "README.md",
      "CONTEXT.md",
      "docs/**"
    ],
    "maxStaleDays": 14,
    "requireUpdateWithCodeChange": false,
    "exemptPatterns": [
      "**/*.test.*",
      "tests/**"
    ]
  },
  "evidenceConfig": {
    "screenshotDir": ".harness/evidence",
    "retentionDays": 30,
    "requiredForUI": false,
    "browserTool": "puppeteer"
  },
  "monorepo": {
    "enabled": false,
    "packages": [],
    "sharedChecks": []
  },
  "protected_files": [
    ".github/workflows/**",
    "harness.config.json",
    "CLAUDE.md"
  ],
  "aiPlatform": "claude"
}
